# ---------------------------------------------------------------------------
# Run outputs: regenerable from (git commit, config.json, seed).
# Curated records worth keeping go to experiments/<ID>/ as small JSON files.
# ---------------------------------------------------------------------------
results/
runs/
*.log

# Model checkpoints and other binary training outputs
*.pt
*.pth
*.ckpt
*.safetensors
*.npz
*.npy
*.h5

# Figures are regenerated by every run; commit curated ones under docs/figures/ only
*.png
*.svg
*.pdf
!docs/figures/*.png
!docs/figures/*.svg

# Experiment-tracking tool outputs (not used by default)
mlruns/
wandb/
lightning_logs/

# Datasets: real flight data stays private unless explicitly released
data/
*.csv
*.parquet

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/
.conda/

# ---------------------------------------------------------------------------
# Secrets and local configuration (never commit)
# ---------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
credentials*.json
secrets*

# ---------------------------------------------------------------------------
# Editors, assistants and OS files
# ---------------------------------------------------------------------------
.idea/
.vscode/
.claude/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
